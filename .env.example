# =========================================================
# HAIYO — Environment Variables Template
# =========================================================
# Copy file ini menjadi .env.local untuk pengembangan lokal.
# PENTING: SUPABASE_SERVICE_ROLE_KEY & PAYMENT_*_SECRET
# HANYA boleh berada di server-side, JANGAN pernah diberi
# prefix NEXT_PUBLIC_.

# 1. Supabase Public Config (Aman untuk Client/Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Server-Only Secret (JANGAN ekspos ke Frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Payment Gateway Config (Server-Only, untuk Phase 9)
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret
PAYMENT_SERVER_KEY=your-payment-gateway-server-key
